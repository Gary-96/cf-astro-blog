/*
  Cache-Control: public, max-age=0, must-revalidate

# 静态资源长期缓存（365天）
/._astro/*
/public/*
/*.css
/*.js
/*.svg
/*.woff2
/*.woff
/*.ttf
/*.eot
/*.png
/*.jpg
/*.jpeg
/*.webp
/*.gif
/*.ico
  Cache-Control: public, max-age=31536000, immutable

# API 短期缓存
/api/*
  Cache-Control: public, max-age=60, stale-while-revalidate=300
