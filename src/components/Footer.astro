---
import { siteConfig } from "@/lib/types";

const year = new Date().getFullYear();
---

<footer class="site-footer" data-footer-reveal>
	<div class="container">
		<div class="footer-inner glass-panel">
			<div class="footer-copy">
				<p class="footer-title">{siteConfig.name}</p>
			</div>
			<nav class="footer-nav" aria-label="辅助导航">
				<a href="/about">关于</a>
				<a href="/contact">联系</a>
				<a href="/privacy">隐私政策</a>
			</nav>
			<p class="footer-meta">
				© {year} · {siteConfig.author}
			</p>
		</div>
	</div>
</footer>

<style>
	.footer-nav {
		display: flex;
		flex-wrap: wrap;
		gap: 0.6rem 1.2rem;
		padding: 0.75rem 0 0.25rem;
		border-top: 1px solid var(--color-border);
		margin-top: 0.5rem;
	}

	.footer-nav a {
		font-size: 0.82rem;
		color: var(--color-text-muted);
		text-decoration: none;
		transition: color var(--transition);
	}

	.footer-nav a:hover {
		color: var(--color-accent);
	}
</style>
