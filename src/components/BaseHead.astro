---
import { ClientRouter } from "astro:transitions";
import { siteConfig } from "@/lib/types";

interface Props {
	title: string;
	description?: string;
	image?: string;
	canonicalUrl?: string;
	publishedAt?: string;
	authorName?: string;
	categoryName?: string;
}

const {
	title,
	description = siteConfig.description,
	image,
	canonicalUrl,
	publishedAt,
	authorName,
	categoryName,
} = Astro.props;

const fullTitle =
	title === siteConfig.name ? title : `${title} · ${siteConfig.name}`;
const resolvedUrl = canonicalUrl || Astro.url.href;
const isArticlePage = Astro.url.pathname.startsWith("/blog/");
const isHomePage = Astro.url.pathname === "/";
const isAboutPage = Astro.url.pathname === "/about";
const isContactPage = Astro.url.pathname === "/contact";

// ─── 文章结构化数据 ────────────────────────────────────────────────────────
let blogPostingJson: object | undefined;
if (isArticlePage) {
	blogPostingJson = {
		"@context": "https://schema.org",
		"@type": "BlogPosting",
		headline: title,
		description,
		image: image ? [image] : undefined,
		datePublished: publishedAt,
		dateModified: publishedAt,
		author: authorName
			? { "@type": "Person", "name": authorName }
			: { "@type": "Organization", "name": siteConfig.name },
		publisher: {
			"@type": "Organization",
			name: siteConfig.name,
			logo: { "@type": "ImageObject", url: "/favicon.svg" },
		},
		mainEntityOfPage: {
			"@type": "WebPage",
			"@id": resolvedUrl,
		},
	};
}

// ─── 网站结构化数据（全站） ────────────────────────────────────────────────
const webSiteJson = {
	"@context": "https://schema.org",
	"@type": "WebSite",
	name: siteConfig.name,
	url: siteConfig.url,
	description: siteConfig.description,
	inLanguage: "zh-CN",
};

// ─── 组织结构化数据（关于我们页） ────────────────────────────────────────
let organizationJson: object | undefined;
if (isAboutPage) {
	organizationJson = {
		"@context": "https://schema.org",
		"@type": "Organization",
		name: siteConfig.name,
		url: siteConfig.url,
		logo: { "@type": "ImageObject", url: "/favicon.svg" },
		sameAs: [],
	};
}

// ─── FAQ 结构化数据（联系页） ──────────────────────────────────────────────
let faqPageJson: object | undefined;
if (isContactPage) {
	faqPageJson = {
		"@context": "https://schema.org",
		"@type": "FAQPage",
		mainEntity: [],
	};
}
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="generator" content={Astro.generator} />
<meta name="theme-color" content="#0a84ff" />
<meta name="color-scheme" content="light dark" />
<ClientRouter />

<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={resolvedUrl} />

<!-- Favicon -->
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="apple-touch-icon" href="/favicon.svg" sizes="180x180" />
<meta name="apple-mobile-web-app-title" content={siteConfig.name} />
<meta name="application-name" content={siteConfig.name} />
<meta name="msapplication-TileColor" content="#0a84ff" />

<link rel="sitemap" href="/sitemap.xml" />
<link rel="alternate" type="application/rss+xml" title={`${siteConfig.name} RSS`} href="/rss.xml" />
<link rel="webmention" href="/api/webmention" />

<!-- Open Graph -->
<meta property="og:type" content={isArticlePage ? "article" : "website"} />
<meta property="og:url" content={resolvedUrl} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:locale" content="zh_CN" />
{isArticlePage && <meta property="article:published_time" content={publishedAt} />}
{isArticlePage && authorName && <meta property="article:author" content={authorName} />}
{isArticlePage && categoryName && <meta property="article:section" content={categoryName} />}
{image && <meta property="og:image" content={image} />}
{image && <meta property="og:image:alt" content={description} />}

<!-- Twitter Card -->
<meta name="twitter:card" content={image ? "summary_large_image" : "summary"} />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
{image && <meta name="twitter:image" content={image} />}
{image && <meta name="twitter:image:alt" content={description} />}

<!-- 结构化数据 -->
<script type="application/ld+json" set:html={JSON.stringify(webSiteJson)} />
{blogPostingJson && (
	<script type="application/ld+json" set:html={JSON.stringify(blogPostingJson)} />
)}
{organizationJson && (
	<script type="application/ld+json" set:html={JSON.stringify(organizationJson)} />
)}
{faqPageJson && (
	<script type="application/ld+json" set:html={JSON.stringify(faqPageJson)} />
)}