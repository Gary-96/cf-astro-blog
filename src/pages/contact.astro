---
import Base from "@/layouts/Base.astro";
import { siteConfig } from "@/lib/types";

const description =
	"通过 GitHub、邮箱或社交媒体与博主 Gary 取得联系，进行技术交流与合作。";
---

<Base title={`联系 · ${siteConfig.name}`} description={description}>
	<div class="page-prose">
		<div class="page-hero-glass">
			<span class="page-kicker">Contact</span>
			<h1 class="page-title-large">联系我</h1>
			<p class="page-lead">
				如果你有任何技术问题想交流，或者对项目有合作意向，欢迎通过以下方式联系我。我会在合理时间内回复每一条消息。
			</p>
		</div>

		<div class="contact-grid">
			<a
				href="https://github.com/Gary-96"
				target="_blank"
				rel="noopener noreferrer"
				class="contact-card glass-panel"
			>
				<div class="contact-icon-wrap">
					<svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
						<path
							d="M12 2C6.477 2 2 6.477 2 12c0 4.42 2.865 8.17 6.839 9.49.5.092.682-.217.682-.482 0-.237-.008-.866-.013-1.7-2.782.603-3.369-1.342-3.369-1.342-.454-1.155-1.11-1.462-1.11-1.462-.908-.62.069-.608.069-.608 1.003.07 1.531 1.03 1.531 1.03.892 1.529 2.341 1.087 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.11-4.555-4.943 0-1.091.39-1.984 1.029-2.683-.103-.253-.446-1.27.098-2.647 0 0 .84-.269 2.75 1.025A9.578 9.578 0 0112 6.836c.85.004 1.705.114 2.504.336 1.909-1.294 2.747-1.025 2.747-1.025.546 1.377.202 2.394.1 2.647.64.699 1.028 1.592 1.028 2.683 0 3.842-2.339 4.687-4.566 4.935.359.309.678.919.678 1.852 0 1.336-.012 2.415-.012 2.743 0 .267.18.578.688.48C19.138 20.167 22 16.418 22 12c0-5.523-4.477-10-10-10z"
							fill="currentColor"
						/>
					</svg>
				</div>
				<div class="contact-info">
					<span class="contact-label">GitHub</span>
					<span class="contact-value">@Gary-96</span>
					<span class="contact-desc">开源项目与 Issue 交流</span>
				</div>
				<svg class="contact-arrow" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
					<path d="M6 3l5 5-5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
				</svg>
			</a>

			<a
				href="mailto:support@gnnis.com"
				class="contact-card glass-panel"
			>
				<div class="contact-icon-wrap">
					<svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
						<path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
						<polyline points="22,6 12,13 2,6" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
					</svg>
				</div>
				<div class="contact-info">
					<span class="contact-label">邮箱</span>
					<span class="contact-value">support@gnnis.com</span>
					<span class="contact-desc">商务洽谈与合作咨询</span>
				</div>
				<svg class="contact-arrow" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
					<path d="M6 3l5 5-5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
				</svg>
			</a>

			<a
				href="https://twitter.com/"
				target="_blank"
				rel="noopener noreferrer"
				class="contact-card glass-panel"
			>
				<div class="contact-icon-wrap">
					<svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
						<path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
					</svg>
				</div>
				<div class="contact-info">
					<span class="contact-label">X (Twitter)</span>
					<span class="contact-value">@your_handle</span>
					<span class="contact-desc">技术动态与碎片思考</span>
				</div>
				<svg class="contact-arrow" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
					<path d="M6 3l5 5-5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
				</svg>
			</a>
		</div>

		<div class="contact-note glass-panel">
			<p class="contact-note-title">关于回复</p>
			<p class="contact-note-body">
				我通常会在工作日的晚上或周末处理非紧急消息。如果你希望获得更快的反馈，GitHub Issues 是最高效的渠道。
				所有技术交流均欢迎，无论是项目协作、技术探讨还是简单的代码问题。
			</p>
		</div>
	</div>
</Base>

<style>
	.page-prose {
		display: grid;
		gap: 2rem;
		max-width: 72rem;
		margin: 0 auto;
		padding: clamp(2rem, 4vw, 3.5rem) 0;
	}

	.page-hero-glass {
		position: relative;
		padding: clamp(2rem, 4vw, 3rem);
		border-radius: var(--radius-panel);
		background: rgba(var(--card-surface-rgb), calc(var(--hero-card-opacity, 14) / 100));
		backdrop-filter: blur(var(--hero-card-blur, 18px)) saturate(148%);
		-webkit-backdrop-filter: blur(var(--hero-card-blur, 18px)) saturate(148%);
		border: 1px solid rgba(255, 255, 255, 0.14);
		box-shadow: var(--shadow-card);
		overflow: hidden;
	}

	.page-hero-glass::before {
		content: "";
		position: absolute;
		inset: 0;
		background: linear-gradient(
			145deg,
			rgba(var(--card-sheen-rgb), 0.18) 0%,
			rgba(var(--card-sheen-rgb), 0.04) 40%,
			transparent 100%
		);
		pointer-events: none;
	}

	.page-kicker {
		position: relative;
		display: inline-block;
		font-size: 0.72rem;
		font-family: var(--font-strong);
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: var(--color-accent);
		margin-bottom: 0.85rem;
	}

	.page-title-large {
		position: relative;
		font-size: clamp(2.4rem, 1.8rem + 2.4vw, 3.6rem);
		font-weight: 700;
		line-height: 1.08;
		letter-spacing: -0.035em;
		color: var(--color-text);
		margin: 0 0 1rem;
	}

	.page-lead {
		position: relative;
		font-size: clamp(1.05rem, 0.9rem + 0.6vw, 1.25rem);
		line-height: 1.72;
		color: var(--color-text-secondary);
		max-width: 42rem;
	}

	.contact-grid {
		display: grid;
		gap: 1rem;
		grid-template-columns: repeat(auto-fit, minmax(24rem, 1fr));
	}

	.contact-card {
		position: relative;
		display: flex;
		align-items: center;
		gap: 1.1rem;
		padding: 1.35rem 1.5rem;
		border-radius: var(--radius-card);
		background: rgba(var(--card-surface-rgb), calc(var(--post-card-opacity, 14) / 100));
		backdrop-filter: blur(var(--post-card-blur, 18px)) saturate(130%);
		-webkit-backdrop-filter: blur(var(--post-card-blur, 18px)) saturate(130%);
		border: 1px solid rgba(255, 255, 255, 0.11);
		box-shadow: var(--shadow-card);
		color: inherit;
		text-decoration: none;
		transition: transform var(--transition), box-shadow var(--transition), border-color var(--transition);
		overflow: hidden;
	}

	.contact-card::before {
		content: "";
		position: absolute;
		inset: 0;
		background: linear-gradient(
			145deg,
			rgba(var(--card-sheen-rgb), 0.12) 0%,
			transparent 60%
		);
		pointer-events: none;
	}

	.contact-card:hover {
		transform: translateY(-3px);
		box-shadow:
			0 24px 56px -36px var(--color-shadow-strong),
			0 8px 20px -14px var(--color-shadow);
		border-color: rgba(255, 255, 255, 0.2);
	}

	.contact-card:hover .contact-arrow {
		transform: translate(3px, -3px);
	}

	.contact-icon-wrap {
		flex-shrink: 0;
		width: 3rem;
		height: 3rem;
		display: flex;
		align-items: center;
		justify-content: center;
		border-radius: var(--radius-inner);
		background: var(--color-accent-soft);
		color: var(--color-accent);
	}

	.contact-info {
		display: grid;
		gap: 0.2rem;
		min-width: 0;
		flex: 1;
	}

	.contact-label {
		font-size: 0.72rem;
		font-family: var(--font-strong);
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--color-text-muted);
	}

	.contact-value {
		font-size: 1.05rem;
		font-weight: 600;
		color: var(--color-text);
		letter-spacing: -0.01em;
	}

	.contact-desc {
		font-size: 0.84rem;
		color: var(--color-text-muted);
	}

	.contact-arrow {
		flex-shrink: 0;
		color: var(--color-text-muted);
		transition: transform var(--transition);
	}

	.contact-note {
		padding: clamp(1.2rem, 2vw, 1.6rem);
		border-radius: var(--radius-card);
		background: rgba(var(--card-surface-rgb), calc(var(--post-card-opacity, 14) / 100));
		backdrop-filter: blur(var(--post-card-blur, 18px)) saturate(130%);
		-webkit-backdrop-filter: blur(var(--post-card-blur, 18px)) saturate(130%);
		border: 1px solid rgba(255, 255, 255, 0.11);
		box-shadow: var(--shadow-card);
	}

	.contact-note-title {
		font-size: 0.92rem;
		font-weight: 700;
		color: var(--color-text);
		margin: 0 0 0.6rem;
	}

	.contact-note-body {
		font-size: 0.94rem;
		line-height: 1.76;
		color: var(--color-text-secondary);
		margin: 0;
	}

	@media (max-width: 640px) {
		.contact-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
